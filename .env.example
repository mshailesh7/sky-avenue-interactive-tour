PORT=8080
NODE_ENV=development

# Customize MONGODB_URI to point to your local MongoDB or a MongoDB Atlas Cloud URI
MONGODB_URI=mongodb://localhost:27017/sky_avenue_360

# Admin account (only used when the database has no users)
ADMIN_PHONE=9876543210
ADMIN_INITIAL_PASSWORD=change-me-to-a-strong-password

# Set to true when serving over HTTPS in non-production environments
# COOKIE_SECURE=true
